# Dockerfile.jenkins
FROM jenkins/jenkins:lts-jdk17

USER root

# Instalar Python + Firefox ESR + dependencias
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    firefox-esr \
    xvfb \
    libgtk-3-0 libdbus-glib-1-2 libxt6 \
    wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Python como comando principal
RUN ln -s /usr/bin/python3 /usr/bin/python

# Geckodriver (versión fija, sin API)
RUN wget -O /tmp/geckodriver.tar.gz \
    https://github.com/mozilla/geckodriver/releases/download/v0.34.0/geckodriver-v0.34.0-linux64.tar.gz \
    && tar -xzf /tmp/geckodriver.tar.gz -C /usr/local/bin \
    && chmod +x /usr/local/bin/geckodriver \
    && rm /tmp/geckodriver.tar.gz

# Script para ejecutar con Xvfb automáticamente
RUN echo '#!/bin/bash\n/usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24 -ac" "$@"' > /usr/local/bin/xvfb-run-safe \
    && chmod +x /usr/local/bin/xvfb-run-safe

USER jenkins